# Batch 6a: match/case with literal patterns.

x = 2
match x:
    case 1:
        print("one")
    case 2:
        print("two")
    case _:
        print("other")

print("---")

cmd = "pause"
match cmd:
    case "start":
        print("starting")
    case "stop":
        print("stopping")
    case _:
        print("unknown command")

print("---")

flag = True
match flag:
    case True:
        print("flag is true")
    case False:
        print("flag is false")

print("---")

def get_code():
    return 404

match get_code():
    case 200:
        print("OK")
    case 404:
        print("Not Found")
    case _:
        print("Unknown")

print("---")

n = 5
match n:
    case 1:
        print("one")
        print("first case")
    case 5:
        print("five")
        print("second case")
    case _:
        print("fallback")
