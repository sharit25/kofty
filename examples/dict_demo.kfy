# pyright: reportUndefinedVariable=false

person = {"name": "Alice", "city": "Paris", "country": "France"}
print("Name: " + person["name"])
print("City: " + person["city"])

person["city"] = "London"
print("Updated city: " + person["city"])

person["age"] = "30"
print("Age: " + person["age"])

scores = {"alice": 100, "bob": 85, "carol": 92}
print("Alice: " + str(scores["alice"]))
print("Bob: " + str(scores["bob"]))

scores["bob"] = 90
print("Bob updated: " + str(scores["bob"]))
