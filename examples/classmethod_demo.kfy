class Temperature:
    def __init__(self, c):
        self._c = c

    @classmethod
    def from_fahrenheit(klass, f):
        return klass((f - 32) * 5 // 9)

    @classmethod
    def freezing(klass):
        return klass(0)

    @property
    def celsius(self):
        return self._c

t = Temperature.from_fahrenheit(212)
print(t.celsius)

f = Temperature.freezing()
print(f.celsius)
