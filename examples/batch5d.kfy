# Batch 5d: lambdas.

twice = lambda x: x * 2
print(twice(5))

print("---")

add = lambda a, b: a + b
print(add(3, 4))

print("---")

base = 100
add_base = lambda x: x + base
print(add_base(5))

print("---")

is_even = lambda n: n % 2 == 0
print(is_even(4))
print(is_even(5))

print("---")

larger = lambda a, b: a if a > b else b
print(larger(3, 7))
print(larger(10, 2))

print("---")

square = lambda x: x * x
print(square(2))
print(square(3))
print(square(4))

print("---")

greeting = "Hello, "
greet = lambda name: greeting + name
print(greet("Alice"))
